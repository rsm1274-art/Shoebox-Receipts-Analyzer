{
  "name": "receipt-audit-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pure TypeScript core for Receipt Audit: categorizing, tax/tip splits, audit flags, parsing and export builders.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "golden:capture": "tsx tests/oracle/capture.ts",
    "bundle:core": "node scripts/bundle-core.mjs",
    "build:releases": "node scripts/build-releases.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "acorn": "^8.14.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
